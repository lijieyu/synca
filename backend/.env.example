PORT=3002

# Apple Sign in with Apple
APPLE_CLIENT_ID=org.haerth.synca
APP_STORE_APPLE_ID=1234567890
LIFETIME_UPGRADE_MONTHLY_PRICE_LABEL=¥78
LIFETIME_UPGRADE_YEARLY_PRICE_LABEL=¥58

# APNs Push Notifications (reuse everbond's .p8 key)
APNS_ENABLED=false
APNS_KEY_ID=your-apns-key-id
APNS_TEAM_ID=your-apns-team-id
APNS_TOPIC=org.haerth.synca
APNS_AUTH_KEY_PATH=./apns-key.p8

# Canonical external origin used by MCP OAuth and confirmation URLs (no trailing path).
PUBLIC_URL=https://synca.haerth.cn

# Email sign-in: Aliyun DirectMail. Server-only; never expose these to clients.
# Use a RAM identity restricted to dm:SingleSendMail and a verified transactional
# sender in the SAME region as ALIYUN_DM_REGION. Missing configuration disables delivery.
ALIYUN_DM_ACCESS_KEY_ID=
ALIYUN_DM_ACCESS_KEY_SECRET=
ALIYUN_DM_ACCOUNT_NAME=
# Allowed regions: cn-hangzhou (default), ap-southeast-1, ap-southeast-2,
# us-east-1, eu-central-1. Current official endpoints use API version 2015-11-23.
ALIYUN_DM_REGION=cn-hangzhou
# Optional STS security token: must be refreshed along with the temporary key pair.
ALIYUN_DM_SECURITY_TOKEN=
# At least 32 random bytes, generated on the server (e.g. openssl rand -hex 32).
# Used to HMAC email codes; keep stable across restarts. Rotation expires pending codes.
EMAIL_AUTH_SECRET=
