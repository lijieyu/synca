{
  "name": "web",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run markdown:check && tsc -b && vite build && node scripts/build-ai-page.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "sync-i18n": "node scripts/sync-i18n.js",
    "markdown:bundle": "node scripts/build-markdown-parser.mjs",
    "markdown:check": "node scripts/build-markdown-parser.mjs --check",
    "test:markdown": "node --test tests/markdown-parser.test.ts tests/markdown-bundle.test.mjs",
    "test:node": "node --test tests/*.test.mjs tests/markdown-parser.test.ts tests/scratchpad.test.ts tests/collections.test.ts tests/change-notifications.test.ts"
  },
  "dependencies": {
    "i18next": "^26.0.3",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^1.7.0",
    "pinyin-pro": "^3.29.5",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-i18next": "^17.0.2",
    "react-router-dom": "^7.14.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-gfm": "^3.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1",
    "rolldown": "1.0.0-rc.12"
  }
}
